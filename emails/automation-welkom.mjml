<mjml lang="nl">
  <mj-head>
    <mj-title>Bedankt voor je aanvraag</mj-title>
    <mj-preview>Je aanvraag is binnen. Ik kom er persoonlijk op terug, meestal dezelfde werkdag nog.</mj-preview>
    <mj-attributes>
      <mj-all font-family="Arial, Helvetica, sans-serif" />
      <mj-text font-size="16px" line-height="1.6" color="#1a1a1a" padding="0 28px 16px" />
      <mj-section background-color="#ffffff" padding="0" />
      <mj-body background-color="#f5f5f5" />
    </mj-attributes>
    <mj-style inline="inline">
      a.swd-link { color: #e63329; }
      a.swd-unsub { color: #888888; }
    </mj-style>
  </mj-head>
  <mj-body width="600px">
    <mj-section padding="24px 0 0" background-color="#f5f5f5"></mj-section>

    <!-- Wordmerk (tekst, geen afbeelding — huisregel) -->
    <mj-section padding="28px 0 8px">
      <mj-column>
        <mj-text font-size="18px" font-weight="bold" letter-spacing="1px" color="#0a0a0a" padding="0 28px">
          STOLK<span style="color:#e63329;">WEB</span>DESIGN
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Bericht -->
    <mj-section padding="16px 0 0">
      <mj-column>
        <mj-text>Hoi {{voornaam|daar}},</mj-text>
        <mj-text>Bedankt voor je bericht. Ik heb je aanvraag binnen en kom er persoonlijk op terug, meestal dezelfde werkdag nog.</mj-text>
        <mj-text>Wil je alvast een indruk van het werk? Bekijk een paar recente projecten:</mj-text>
        <mj-button href="https://stolkwebdesign.nl/#werk" align="left"
          background-color="#0a0a0a" color="#ffffff" font-size="16px"
          border-radius="0" inner-padding="12px 22px" padding="0 28px 24px">
          Bekijk recent werk
        </mj-button>
        <mj-text>Liever direct een moment prikken? Dat kan ook:</mj-text>
        <mj-text padding="0 28px 24px">
          <a class="swd-link" href="https://stolkwebdesign.nl/contact.html">Plan een kennismaking</a>
        </mj-text>
        <mj-text padding="0 28px 16px">Groet,<br>Peter Stolk<br><span style="color:#888888;">Stolkwebdesign</span></mj-text>
      </mj-column>
    </mj-section>

    <!-- Footer / uitschrijven -->
    <mj-section padding="0 0 28px">
      <mj-column>
        <mj-text font-size="12px" color="#888888" padding="16px 28px 0">
          Geen mail meer ontvangen? <a class="swd-unsub" href="{{unsubscribe_url}}">Schrijf je uit</a>.
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding="0 0 24px" background-color="#f5f5f5"></mj-section>
  </mj-body>
</mjml>
